{
  "name": "dsh-time-ink",
  "description": "给每次用户消息注入当前系统时间：回合首步时钟戳（模型可见、折叠呈现、缓存近无损）",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": {
      "default": "./src/index.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/schemastery": ">=3.0.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis"
  ]
}
